[Desktop Entry]
Type=Application
Name=g-File
Name[tr]=g-File
GenericName=File Manager
GenericName[tr]=Dosya Yöneticisi
Comment=Modern file manager for Linux
Comment[tr]=Yerel, ağ ve bulut dosyaları için modern dosya yöneticisi
Exec=@GFILE_DESKTOP_EXEC@
