# Only the last installation recorded by this build tree is removed. Never
# recursively remove installation directories: they can contain user vaults,
# models, settings and files belonging to other applications.
set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR
        "No install_manifest.txt found. Keep the build directory used to install Lurviko, "
        "and run its uninstall target. Package-manager installations must be removed "
        "using the package manager.")
endif()

file(STRINGS "${manifest}" installed_files ENCODING UTF-8)
# Validate the entire list before removing anything.
foreach(installed_file IN LISTS installed_files)
    if(NOT IS_ABSOLUTE "${installed_file}" OR installed_file MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Invalid installation path: ${installed_file}")
    endif()
    set(staged_file "$ENV{DESTDIR}${installed_file}")
    if(IS_DIRECTORY "${staged_file}" AND NOT IS_SYMLINK "${staged_file}")
        message(FATAL_ERROR "Refusing to remove a directory: ${staged_file}")
    endif()
endforeach()

# Older source installs created this alias without recording it in the
# manifest. Remove it only if it is still Lurviko's relative symlink.
foreach(installed_file IN LISTS installed_files)
    if(installed_file MATCHES "/lurviko$")
        get_filename_component(binary_dir "${installed_file}" DIRECTORY)
        set(legacy_alias "$ENV{DESTDIR}${binary_dir}/g-file")
        if(IS_SYMLINK "${legacy_alias}")
            file(READ_SYMLINK "${legacy_alias}" alias_target)
            if(alias_target STREQUAL "lurviko")
                list(APPEND installed_files "${binary_dir}/g-file")
            endif()
        endif()
    endif()
endforeach()

foreach(installed_file IN LISTS installed_files)
    set(staged_file "$ENV{DESTDIR}${installed_file}")
    if(EXISTS "${staged_file}" OR IS_SYMLINK "${staged_file}")
        message(STATUS "Removing: ${staged_file}")
        execute_process(COMMAND "@CMAKE_COMMAND@" -E rm -f "${staged_file}"
            RESULT_VARIABLE removal_result ERROR_VARIABLE removal_error)
        if(NOT removal_result STREQUAL "0")
            message(FATAL_ERROR "Could not remove ${staged_file}: ${removal_error}")
        endif()
    else()
        message(STATUS "Already absent: ${staged_file}")
    endif()
endforeach()
# xdg-desktop-portal selects a backend by its *.portal file alone, without
# checking that it can still be started. If this installation provided the
# file chooser backend, drop Lurviko from the user's portal choice so Open/Save
# dialogs fall back to the desktop's own (a portal definition installed into
# /usr/share with administrator rights may outlive a user-prefix install).
set(provided_portal FALSE)
foreach(installed_file IN LISTS installed_files)
    if(installed_file MATCHES "/org\\.freedesktop\\.impl\\.portal\\.desktop\\.lurviko\\.service$")
        set(provided_portal TRUE)
    endif()
endforeach()
if(provided_portal AND "$ENV{DESTDIR}" STREQUAL "")
    set(portal_config_dir "$ENV{XDG_CONFIG_HOME}")
    if(portal_config_dir STREQUAL "")
        set(portal_config_dir "$ENV{HOME}/.config")
    endif()
    file(GLOB portal_configs "${portal_config_dir}/xdg-desktop-portal/*portals.conf")
    set(portal_choice_changed FALSE)
    foreach(portal_config IN LISTS portal_configs)
        file(READ "${portal_config}" portal_text)
        if(portal_text MATCHES "^# Created by Lurviko ")
            message(STATUS "Removing Lurviko's file dialog choice: ${portal_config}")
            file(REMOVE "${portal_config}")
            set(portal_choice_changed TRUE)
        elseif(portal_text MATCHES "org\\.freedesktop\\.impl\\.portal\\.FileChooser=[ \t]*lurviko")
            string(REGEX REPLACE "(org\\.freedesktop\\.impl\\.portal\\.FileChooser=)[ \t]*lurviko;?" "\\1"
                portal_text "${portal_text}")
            string(REGEX REPLACE "(^|\n)org\\.freedesktop\\.impl\\.portal\\.FileChooser=[ \t]*(\n|$)" "\\1"
                portal_text "${portal_text}")
            message(STATUS "Removing Lurviko from the file dialog choice: ${portal_config}")
            file(WRITE "${portal_config}" "${portal_text}")
            set(portal_choice_changed TRUE)
        endif()
    endforeach()
    # Lurviko's env script routes KDE/Qt and GTK apps to the portal; without
    # Lurviko that is pointless, so remove it with the portal choice.
    set(portal_env_script "${portal_config_dir}/plasma-workspace/env/lurviko-file-dialogs.sh")
    if(EXISTS "${portal_env_script}")
        file(READ "${portal_env_script}" portal_env_text)
        if(portal_env_text MATCHES "^# Created by Lurviko ")
            message(STATUS "Removing: ${portal_env_script}")
            file(REMOVE "${portal_env_script}")
        endif()
    endif()
    # The portal reads its configuration at startup.
    if(portal_choice_changed AND NOT "$ENV{LURVIKO_UNINSTALL_NO_PORTAL_RESTART}" STREQUAL "1")
        execute_process(COMMAND systemctl --user try-restart xdg-desktop-portal.service
            RESULT_VARIABLE ignored OUTPUT_QUIET ERROR_QUIET)
    endif()
endif()
message(STATUS "Lurviko uninstalled. User settings, caches and personal data were kept.")
