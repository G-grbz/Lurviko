* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.qml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.png binary

# AUR metadata contains the checksum of the source archive itself. Keep it in
# Git, but outside that archive so it can be finalized in the same commit.
/packaging/aur export-ignore
